# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Generate a token:
#   openssl rand -hex 32
#
# At least 32 characters. The relay refuses to start below that, because
# anything holding this token can drive a tool-capable agent on every
# connected machine.
RELAY_TOKEN=

# Optional overrides.
# RELAY_SESSION_TTL_SECS=900
# RELAY_EVENT_BUFFER=500
# RUST_LOG=claurst_relay=debug
