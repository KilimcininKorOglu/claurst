{
  "name": "claurst-vscode",
  "displayName": "Claurst",
  "description": "Chat with Claurst, an AI coding agent, without leaving VS Code.",
  "version": "0.1.7",
  "publisher": "kilimcininkoroglu",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KilimcininKorOglu/claurst.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claurst.openChat",
        "title": "Claurst: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "claurst.newSession",
        "title": "Claurst: New Session"
      },
      {
        "command": "claurst.stopSession",
        "title": "Claurst: Stop Current Turn"
      },
      {
        "command": "claurst.resumeSession",
        "title": "Claurst: Resume Session"
      },
      {
        "command": "claurst.forkSession",
        "title": "Claurst: Fork Session"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "claurst.openChat"
        },
        {
          "command": "claurst.newSession"
        },
        {
          "command": "claurst.stopSession"
        },
        {
          "command": "claurst.resumeSession"
        },
        {
          "command": "claurst.forkSession"
        }
      ]
    },
    "configuration": {
      "title": "Claurst",
      "properties": {
        "claurst.executablePath": {
          "type": "string",
          "default": "claurst",
          "description": "Path to the claurst executable. Defaults to resolving 'claurst' from PATH."
        },
        "claurst.hostTerminals": {
          "type": "boolean",
          "default": false,
          "description": "Run the agent's shell commands in this extension instead of in the agent, so their output appears live in the chat panel. Off by default: the agent runs commands in a real PTY, and this runs them on a pipe, so anything that checks whether it is attached to a terminal (npm, cargo, git, pytest) behaves differently."
        },
        "claurst.requestTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 1,
          "description": "How long to wait for the agent to answer a request before reporting it as failed. Does not apply to a running turn, which lasts as long as the model and its tools take and is ended with Stop."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc -p ./ && tsc -p src/webview",
    "vscode:prepublish": "npm run check && node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0"
  }
}
